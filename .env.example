# Application Environment (production | development)
NODE_ENV=development

# Server Port (Default: 5000)
PORT=5000

# Frontend URL for CORS (Leave empty if frontend & backend share the same domain)
CLIENT_ORIGIN=http://localhost:5173

# External Result API Integration (Optional - default is false)
# When false, the application works completely using local/backend data
ENABLE_EXTERNAL_API=false
EXTERNAL_API_BASE=
EXTERNAL_API_TOKEN=

# Rate Limiting (Default: 60 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
